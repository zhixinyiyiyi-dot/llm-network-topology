{
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ready",
        "needs_clarification"
      ]
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "router",
              "pc",
              "switch",
              "server"
            ]
          },
          "interfaces": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "ipv4": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "name",
                "ipv4"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "default_gateway": {
            "type": [
              "string",
              "null"
            ]
          },
          "routing": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "protocol": {
                      "const": "rip"
                    },
                    "version": {
                      "const": 2
                    },
                    "auto_summary": {
                      "const": false
                    },
                    "networks": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "protocol",
                    "version",
                    "auto_summary",
                    "networks"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "protocol",
                    "process_id",
                    "networks"
                  ],
                  "properties": {
                    "protocol": {
                      "const": "ospf"
                    },
                    "process_id": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    "networks": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "network",
                          "wildcard",
                          "area"
                        ],
                        "properties": {
                          "network": {
                            "type": "string"
                          },
                          "wildcard": {
                            "type": "string"
                          },
                          "area": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 4294967295
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "properties": {
                    "protocol": {
                      "const": "static"
                    },
                    "routes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "prefix": {
                            "type": "string",
                            "minLength": 1
                          },
                          "next_hop": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "prefix",
                          "next_hop"
                        ],
                        "additionalProperties": false
                      },
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "protocol",
                    "routes"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "maxItems": 1
          },
          "nat": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "inside_interface": {
                    "type": "string",
                    "minLength": 1
                  },
                  "outside_interface": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_network": {
                    "type": "string",
                    "minLength": 1
                  },
                  "acl_id": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 99
                  },
                  "pool_name": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_]{0,20}$"
                  },
                  "pool_start": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pool_end": {
                    "type": "string",
                    "minLength": 1
                  },
                  "netmask": {
                    "type": "string",
                    "minLength": 1
                  },
                  "overload": {
                    "const": true
                  }
                },
                "required": [
                  "inside_interface",
                  "outside_interface",
                  "source_network",
                  "acl_id",
                  "pool_name",
                  "pool_start",
                  "pool_end",
                  "netmask",
                  "overload"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "type",
          "interfaces",
          "default_gateway",
          "routing"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "a": {
            "type": "object",
            "properties": {
              "device": {
                "type": "string",
                "minLength": 1
              },
              "interface": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "device",
              "interface"
            ],
            "additionalProperties": false
          },
          "b": {
            "type": "object",
            "properties": {
              "device": {
                "type": "string",
                "minLength": 1
              },
              "interface": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "device",
              "interface"
            ],
            "additionalProperties": false
          },
          "dce": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "device": {
                    "type": "string",
                    "minLength": 1
                  },
                  "interface": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "device",
                  "interface"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "a",
          "b",
          "dce"
        ],
        "additionalProperties": false
      }
    },
    "vlans": {
      "type": "array",
      "maxItems": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "const": "ping"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "destination": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "source",
          "destination"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "case_id",
    "status",
    "questions",
    "devices",
    "links",
    "vlans",
    "checks"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ipv4-rip-v1.schema.json",
  "title": "IPv4 RIP/OSPF DSL v2 (VLAN not yet supported)"
}